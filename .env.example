# --- Claude agent ---------------------------------------------------------
# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for the agent loop. Defaults to claude-sonnet-4-6 if unset.
CLAUDE_MODEL=claude-sonnet-4-6

# --- Data source -----------------------------------------------------------
# "demo" (default) uses the local SQLite file seeded by demo_data/seed_demo_data.py.
# "fabric" switches to the (stubbed) Microsoft Fabric SQL endpoint backend.
DATA_SOURCE=demo

# Path to the demo SQLite database. Defaults to demo_data/ncap_demo.db.
DEMO_DB_PATH=

# --- SQL guardrails ---------------------------------------------------------
# Maximum rows any single query is allowed to return.
SQL_MAX_ROWS=200

# Per-query timeout, in seconds.
SQL_QUERY_TIMEOUT_SECONDS=10

# Max Claude <-> tool-use turns per question before the agent gives up.
AGENT_MAX_TURNS=6

# --- CORS (web UI) -----------------------------------------------------------
# Comma-separated list of allowed origins for the FastAPI backend. "*" allows all.
CORS_ALLOW_ORIGINS=*

# --- Microsoft Fabric (only used when DATA_SOURCE=fabric) -------------------
# SQL endpoint hostname, e.g. xxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_SERVER=
# Fabric/Lakehouse SQL database name
FABRIC_SQL_DATABASE=
# Azure AD service principal used to authenticate against the Fabric SQL endpoint
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Microsoft Teams bot (only used by teams_bot/app.py) --------------------
# Values from your Azure Bot resource registration (manual Azure Portal step —
# see README.md "Path to production"). Leave blank to run the bot unauthenticated
# for local testing with the Bot Framework Emulator.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# Where the Teams bot forwards questions to (the FastAPI backend above).
NCAP_BACKEND_URL=http://localhost:8000

# Port the Teams bot's aiohttp server listens on.
TEAMS_BOT_PORT=3978
